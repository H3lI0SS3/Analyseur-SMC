# GEMINI_API_KEY : injectée automatiquement par AI Studio (panneau Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY : facultative. Active Claude pour relire l'analyse (console.anthropic.com).
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# TWELVE_DATA_API_KEY : facultative mais recommandée. Cotations spot EUR/USD et XAU/USD (twelvedata.com, offre gratuite).
# Sans elle, l'app utilise Yahoo Finance (or via les futures COMEX GC=F).
TWELVE_DATA_API_KEY="MY_TWELVE_DATA_API_KEY"

# MCP_TOKEN : facultatif. Active le connecteur Claude sur /mcp. Mets un code long et aléatoire (16 caractères min.).
MCP_TOKEN=""

# Modèles (facultatif)
# CLAUDE_MODEL="claude-sonnet-5-5"
# GEMINI_MODEL="gemini-2.5-flash"

# APP_URL : injectée par AI Studio.
APP_URL="MY_APP_URL"
