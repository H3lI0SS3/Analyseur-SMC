# GEMINI_API_KEY : injectée automatiquement par AI Studio (panneau Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY : facultative. Active Claude pour relire l'analyse (console.anthropic.com).
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# TWELVE_DATA_API_KEY : facultative mais recommandée. Cotations spot EUR/USD et XAU/USD (twelvedata.com, offre gratuite).
# Sans elle, l'app utilise Yahoo Finance (or via les futures COMEX GC=F).
TWELVE_DATA_API_KEY="MY_TWELVE_DATA_API_KEY"

# ---------- cTrader Open API (FxPro) : bougies au prix du broker, EN LECTURE SEULE ----------
# Application créée sur https://openapi.ctrader.com (menu Applications) ; jeton obtenu via le Playground,
# autorisation « accounts » (lecture seule) recommandée. Sans ces variables, l'app reste sur Twelve Data.
CTRADER_CLIENT_ID=""
CTRADER_CLIENT_SECRET=""
CTRADER_ACCESS_TOKEN=""
# Facultatifs
CTRADER_REFRESH_TOKEN=""
CTRADER_ENV="demo"            # demo ou live (compte réel)
CTRADER_ACCOUNT_ID=""         # ctidTraderAccountId ; vide = premier compte de l'environnement
# CTRADER_SYMBOL_XAU="XAUUSD" # nom du symbole chez le broker s'il est différent
# CTRADER_SYMBOL_EUR="EURUSD"

# ---------- Surveillance automatique + alertes Telegram ----------
# WATCH_SECRET : clé longue et aléatoire (16 caractères min.), mise dans l'adresse appelée toutes les 5 min :
#   https://TON-APP/api/watch/tick?key=WATCH_SECRET   (cron-job.org, gratuit)
WATCH_SECRET=""
# Bot créé avec @BotFather sur Telegram ; chat id : écris au bot puis ouvre /api/watch/telegram-chats?key=WATCH_SECRET
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# MCP_TOKEN : facultatif. Active le connecteur Claude sur /mcp. Mets un code long et aléatoire (16 caractères min.).
MCP_TOKEN=""

# Modèles (facultatif)
# CLAUDE_MODEL="claude-sonnet-5-5"
# GEMINI_MODEL="gemini-3.8-flash"

# APP_URL : injectée par AI Studio.
APP_URL="MY_APP_URL"
